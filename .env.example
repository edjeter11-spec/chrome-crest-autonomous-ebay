# eBay Developer Credentials
# Get these from https://developer.ebay.com/my/keys
EBAY_APP_ID=YOUR_EBAY_APP_ID
EBAY_APP_SECRET=YOUR_EBAY_APP_SECRET
EBAY_SANDBOX=false

# Claude API (optional, for AI card analysis)
ANTHROPIC_API_KEY=YOUR_CLAUDE_API_KEY

# Sentry Error Monitoring (optional, for production error tracking)
SENTRY_DSN=https://YOUR_SENTRY_KEY@o0.ingest.sentry.io/PROJECT_ID
ENVIRONMENT=development
APP_VERSION=1.0.0
SENTRY_AUTH_TOKEN=YOUR_SENTRY_AUTH_TOKEN

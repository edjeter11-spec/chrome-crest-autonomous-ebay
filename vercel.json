{
  "version": 2,
  "builds": [
    {
      "src": "backend/main.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb"
      }
    },
    {
      "src": "frontend/dist/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/auctions/with-verdicts.*",
      "dest": "backend/main.py",
      "headers": { "Cache-Control": "public, s-maxage=300, stale-while-revalidate=1800" }
    },
    {
      "src": "/api/sales/stats.*",
      "dest": "backend/main.py",
      "headers": { "Cache-Control": "public, s-maxage=300, stale-while-revalidate=1800" }
    },
    {
      "src": "/api/sales\\?.*",
      "dest": "backend/main.py",
      "headers": { "Cache-Control": "public, s-maxage=300, stale-while-revalidate=1800" }
    },
    {
      "src": "/api/dashboard.*",
      "dest": "backend/main.py",
      "headers": { "Cache-Control": "public, s-maxage=300, stale-while-revalidate=1800" }
    },
    {
      "src": "/api/sniper/fresh-snipes/.*",
      "dest": "backend/main.py",
      "headers": { "Cache-Control": "public, s-maxage=120, stale-while-revalidate=600" }
    },
    {
      "src": "/api/auctions/snipe/targets.*",
      "dest": "backend/main.py",
      "headers": { "Cache-Control": "public, s-maxage=120, stale-while-revalidate=600" }
    },
    {
      "src": "/api/health",
      "dest": "backend/main.py",
      "headers": { "Cache-Control": "public, s-maxage=60, stale-while-revalidate=300" }
    },
    {
      "src": "/api/(.*)",
      "dest": "backend/main.py"
    },
    {
      "src": "/ws",
      "dest": "backend/main.py"
    },
    {
      "src": "/feed.xml",
      "dest": "backend/main.py",
      "headers": { "Content-Type": "application/rss+xml; charset=utf-8" }
    },
    {
      "src": "/og/(.*)",
      "dest": "backend/main.py"
    },
    {
      "src": "/assets/(.*)",
      "dest": "frontend/dist/assets/$1",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" }
    },
    {
      "src": "/icons/(.*)",
      "dest": "frontend/dist/icons/$1"
    },
    {
      "src": "/manifest.json",
      "dest": "frontend/dist/manifest.json",
      "headers": { "Content-Type": "application/manifest+json" }
    },
    {
      "src": "/robots.txt",
      "dest": "frontend/dist/robots.txt",
      "headers": { "Content-Type": "text/plain" }
    },
    {
      "src": "/sitemap.xml",
      "dest": "backend/main.py"
    },
    {
      "src": "/og-image.png",
      "dest": "frontend/dist/og-image.png",
      "headers": { "Content-Type": "image/png", "Cache-Control": "public, max-age=86400" }
    },
    {
      "src": "/logo.png",
      "dest": "frontend/dist/logo.png",
      "headers": { "Content-Type": "image/png", "Cache-Control": "public, max-age=31536000, immutable" }
    },
    {
      "src": "/sw.js",
      "dest": "frontend/dist/sw.js",
      "headers": { "Content-Type": "application/javascript" }
    },
    { "src": "/auctions/?", "dest": "frontend/dist/auctions/index.html" },
    { "src": "/bin/?", "dest": "frontend/dist/bin/index.html" },
    { "src": "/sales/?", "dest": "frontend/dist/sales/index.html" },
    { "src": "/drivers/?", "dest": "frontend/dist/drivers/index.html" },
    { "src": "/sniper/?", "dest": "frontend/dist/sniper/index.html" },
    { "src": "/portfolio/?", "dest": "frontend/dist/portfolio/index.html" },
    { "src": "/wishlist/?", "dest": "frontend/dist/wishlist/index.html" },
    { "src": "/graded/?", "dest": "frontend/dist/graded/index.html" },
    { "src": "/grade/?", "dest": "frontend/dist/grade/index.html" },
    { "src": "/compare/?", "dest": "frontend/dist/compare/index.html" },
    { "src": "/how-we-score/?", "dest": "frontend/dist/how-we-score/index.html" },
    { "src": "/about/?", "dest": "frontend/dist/about/index.html" },
    { "src": "/faq/?", "dest": "frontend/dist/faq/index.html" },
    {
      "src": "/(.*)",
      "dest": "frontend/dist/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/keepalive",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/sync",
      "schedule": "0 */2 * * *"
    },
    {
      "path": "/api/cron/sold-ingest",
      "schedule": "1 1-23/2 * * *"
    },
    {
      "path": "/api/cron/sync-imminent",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/refresh-bids",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/mark-ended",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/ebay/refresh",
      "schedule": "30 * * * *"
    },
    {
      "path": "/api/sniper/check",
      "schedule": "15 */4 * * *"
    },
    {
      "path": "/api/ebay/refresh-top-page",
      "schedule": "0 */4 * * *"
    },
    {
      "path": "/api/ebay/refresh-stale-premium",
      "schedule": "23 */8 * * *"
    },
    {
      "path": "/api/cron/scrape-free",
      "schedule": "45 */2 * * *"
    },
    {
      "path": "/api/cleanup/card-lots",
      "schedule": "5 5 * * *"
    },
    {
      "path": "/api/audit/stale-prices",
      "schedule": "3 7 * * *"
    },
    {
      "path": "/api/audit/morning-check",
      "schedule": "33 7 * * *"
    },
    {
      "path": "/api/audit/auto-fix",
      "schedule": "12 6 * * *"
    },
    {
      "path": "/api/psa/snapshot",
      "schedule": "0 6 * * 0"
    },
    {
      "path": "/api/email/digest",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/cron/sync-race-results",
      "schedule": "0 6 * * 1,4"
    },
    {
      "path": "/api/cron/refresh-comp-medians",
      "schedule": "15 4 * * *"
    },
    {
      "path": "/api/cron/refresh-basket-history",
      "schedule": "30 4 * * *"
    }
  ],
  "env": {
    "VERCEL": "1",
    "DB_PATH": "/tmp/f1cards.db"
  }
}

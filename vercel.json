{
  "version": 2,
  "builds": [
    {
      "src": "backend/main.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb"
      }
    },
    {
      "src": "frontend/dist/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/main.py"
    },
    {
      "src": "/ws",
      "dest": "backend/main.py"
    },
    {
      "src": "/feed.xml",
      "dest": "backend/main.py",
      "headers": { "Content-Type": "application/rss+xml; charset=utf-8" }
    },
    {
      "src": "/og/(.*)",
      "dest": "backend/main.py"
    },
    {
      "src": "/assets/(.*)",
      "dest": "frontend/dist/assets/$1"
    },
    {
      "src": "/icons/(.*)",
      "dest": "frontend/dist/icons/$1"
    },
    {
      "src": "/manifest.json",
      "dest": "frontend/dist/manifest.json",
      "headers": { "Content-Type": "application/manifest+json" }
    },
    {
      "src": "/robots.txt",
      "dest": "frontend/dist/robots.txt",
      "headers": { "Content-Type": "text/plain" }
    },
    {
      "src": "/sitemap.xml",
      "dest": "backend/main.py"
    },
    {
      "src": "/og-image.png",
      "dest": "frontend/dist/og-image.png",
      "headers": { "Content-Type": "image/png" }
    },
    {
      "src": "/logo.png",
      "dest": "frontend/dist/logo.png",
      "headers": { "Content-Type": "image/png", "Cache-Control": "public, max-age=31536000, immutable" }
    },
    {
      "src": "/sw.js",
      "dest": "frontend/dist/sw.js",
      "headers": { "Content-Type": "application/javascript" }
    },
    {
      "src": "/(.*)",
      "dest": "frontend/dist/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/sync",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/ebay/refresh",
      "schedule": "30 * * * *"
    },
    {
      "path": "/api/sniper/check",
      "schedule": "15 */4 * * *"
    },
    {
      "path": "/api/ebay/refresh-top-page",
      "schedule": "0 */4 * * *"
    },
    {
      "path": "/api/ebay/refresh-stale-premium",
      "schedule": "23 */8 * * *"
    },
    {
      "path": "/api/cron/scrape-free",
      "schedule": "45 */2 * * *"
    },
    {
      "path": "/api/cleanup/card-lots",
      "schedule": "5 5 * * *"
    },
    {
      "path": "/api/audit/stale-prices",
      "schedule": "3 7 * * *"
    },
    {
      "path": "/api/audit/morning-check",
      "schedule": "33 7 * * *"
    },
    {
      "path": "/api/audit/auto-fix",
      "schedule": "12 6 * * *"
    },
    {
      "path": "/api/cron/keepalive",
      "schedule": "*/4 * * * *"
    },
    {
      "path": "/api/psa/snapshot",
      "schedule": "0 6 * * 0"
    },
    {
      "path": "/api/email/digest",
      "schedule": "0 9 * * 1"
    }
  ],
  "env": {
    "VERCEL": "1",
    "DB_PATH": "/tmp/f1cards.db"
  }
}

{
  "manifest_version": 3,
  "name": "F1 Card Vault — Snipe Helper",
  "short_name": "F1 Card Vault",
  "version": "1.0.0",
  "description": "Live verdicts (STRONG_BUY / GOOD_BUY / OVERPRICED) overlaid on every 2025 Topps Chrome F1 listing on eBay. Powered by f1cardvault.com.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "F1 Card Vault",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.ebay.com/*",
    "https://www.f1cardvault.com/*",
    "https://f1cardvault.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.ebay.com/sch/*",
        "https://www.ebay.com/b/*"
      ],
      "js": ["content_search.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.ebay.com/itm/*"
      ],
      "js": ["content_listing.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
